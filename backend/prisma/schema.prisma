datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------- MODELS ----------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("Quản trị viên") // Đảm bảo có trường này
  role      String   @default("STAFF")
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

model MenuItem {
  id         String      @id @default(uuid())
  itemCode   String      @unique
  name       String
  price      Decimal     @db.Decimal(12, 2)
  isAvailable Boolean  @default(true)
  status     String      @default("ACTIVE")   // Thêm trường này
  isDeleted  Boolean     @default(false)      // Thêm trường này
  imageUrl   String?
  categoryId Int
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("menu_items")
}

model Table {
  id          Int      @id @default(autoincrement())
  name        String   @unique // Cho phép lưu "Bàn 01", "VIP 1"...
  capacity    Int      @default(4)
  status      String   @default("available") // "available", "occupied", "reserved"
  guestName   String?  // Tên khách đang ngồi hoặc đặt bàn
  timeSeated  String?  // Thời gian ngồi / giờ đặt
  orderId     String?  // Mã đơn hàng liên kết
  totalAmount String?  // Tổng tiền tạm tính
  
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tables")
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  status        String      @default("PENDING") // PENDING, PREPARING, SERVED, COMPLETED, CANCELLED
  paymentStatus String      @default("UNPAID")  // UNPAID, PAID, REFUNDED
  
  totalAmount   Decimal     @default(0.00) @db.Decimal(12, 2)
  
  tableId       Int?
  table         Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  orderItems    OrderItem[]
  note          String?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: NoAction)
  
  quantity   Int      @default(1)
  price      Decimal  @db.Decimal(12, 2)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("order_items")
}